---
import { SITE_TITLE, NAV_ITEMS, WALINE_SERVER_URL } from '@/consts';
import Search from '@/components/Search.astro';

function isArticleLabel(item: typeof NAV_ITEMS[number]) {
  return item.label === '文章';
}
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-white/80 dark:bg-[var(--color-bg-dark)]/80 border-b border-gray-200/50 dark:border-gray-700/50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2 shrink-0">
        <span class="text-xl font-bold text-primary hover:opacity-80 transition-opacity">
          {SITE_TITLE}
        </span>
      </a>

      <nav class="hidden md:flex items-center gap-1" aria-label="主导航">
        {NAV_ITEMS.map((item) => (
          isArticleLabel(item) ? (
            <div class="relative group">
              <span class="px-3 py-2 text-sm font-medium rounded-lg text-gray-600 dark:text-gray-300 group-hover:text-primary dark:group-hover:text-primary group-hover:bg-primary/5 transition-colors cursor-pointer flex items-center gap-1">
                {item.label}
                <svg class="w-3 h-3 opacity-50 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
              <div class="absolute top-full left-0 mt-1 w-36 py-2 bg-white dark:bg-[var(--color-card-dark)] rounded-xl shadow-lg border border-gray-100 dark:border-gray-700 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                <a href="/categories" class="block px-4 py-2 text-sm text-gray-600 dark:text-gray-300 hover:text-primary hover:bg-primary/5 transition-colors">
                  分类
                </a>
                <a href="/tags" class="block px-4 py-2 text-sm text-gray-600 dark:text-gray-300 hover:text-primary hover:bg-primary/5 transition-colors">
                  标签
                </a>
                <a href="/archives" class="block px-4 py-2 text-sm text-gray-600 dark:text-gray-300 hover:text-primary hover:bg-primary/5 transition-colors">
                  归档
                </a>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class="px-3 py-2 text-sm font-medium rounded-lg text-gray-600 dark:text-gray-300 hover:text-primary dark:hover:text-primary hover:bg-primary/5 transition-colors"
            >
              {item.label}
            </a>
          )
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <div class="relative group">
          <button
            id="user-menu"
            class="p-2 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
            aria-label="用户"
          >
            <svg id="user-default-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <img id="user-avatar" class="w-5 h-5 rounded-full hidden" src="" alt="用户头像" />
          </button>

          <div id="user-dropdown" class="absolute top-full right-0 mt-1 w-36 py-2 bg-white dark:bg-[var(--color-card-dark)] rounded-xl shadow-lg border border-gray-100 dark:border-gray-700 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div id="user-name" class="px-4 py-1.5 text-xs font-medium text-gray-400 border-b border-gray-100 dark:border-gray-700 truncate mb-1">
              未登录
            </div>
            <a href="javascript:void(0)" id="user-settings-btn" class="block px-4 py-2 text-sm text-gray-600 dark:text-gray-300 hover:text-primary hover:bg-primary/5 transition-colors">
              用户设置
            </a>
            <button id="logout-btn" class="w-full text-left px-4 py-2 text-sm text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors hidden">
              退出登录
            </button>
          </div>
        </div>

        <button
          id="search-trigger"
          class="p-2 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
          aria-label="搜索"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>

        <button
          id="theme-toggle"
          class="p-2 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
          aria-label="切换主题"
        >
          <svg class="w-5 h-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="w-5 h-5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
          aria-label="菜单"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <nav class="flex flex-col gap-1">
        {NAV_ITEMS.map((item) => (
          <div>
            <a
              href={isArticleLabel(item) ? undefined : item.href}
              class={`block px-3 py-2 text-sm font-medium rounded-lg text-gray-600 dark:text-gray-300 hover:text-primary hover:bg-primary/5 transition-colors ${isArticleLabel(item) ? 'cursor-pointer' : ''}`}
            >
              {item.label}
            </a>
            {isArticleLabel(item) && (
              <div class="ml-4 space-y-0">
                <a href="/categories" class="block px-3 py-1.5 text-sm text-gray-500 dark:text-gray-400 hover:text-primary transition-colors">
                  分类
                </a>
                <a href="/tags" class="block px-3 py-1.5 text-sm text-gray-500 dark:text-gray-400 hover:text-primary transition-colors">
                  标签
                </a>
                <a href="/archives" class="block px-3 py-1.5 text-sm text-gray-500 dark:text-gray-400 hover:text-primary transition-colors">
                  归档
                </a>
              </div>
            )}
          </div>
        ))}
      </nav>
    </div>
  </div>
</header>

<Search />

<script>
  import { WALINE_SERVER_URL } from '@/consts';

  function handleThemeToggle() {
    var root = document.documentElement;
    var isDark = root.classList.contains('dark');
    if (isDark) {
      root.classList.remove('dark');
      localStorage.theme = 'light';
    } else {
      root.classList.add('dark');
      localStorage.theme = 'dark';
    }
  }

  function handleMobileMenu() {
    var menu = document.getElementById('mobile-menu');
    if (menu) {
      menu.classList.toggle('hidden');
    }
  }

  function updateUserStatus() {
    var userMenu = document.getElementById('user-menu');
    var defaultIcon = document.getElementById('user-default-icon');
    var userAvatar = document.getElementById('user-avatar') as any;
    var userNameEl = document.getElementById('user-name') as any;
    var userSettingsBtn = document.getElementById('user-settings-btn') as any;
    var logoutBtn = document.getElementById('logout-btn') as any;
    
    if (!userMenu || !defaultIcon || !userAvatar || !userNameEl || !userSettingsBtn || !logoutBtn) return;

    var baseUrl = WALINE_SERVER_URL + (WALINE_SERVER_URL.endsWith('/') ? '' : '/');
    var walineUser = localStorage.getItem('WALINE_USER');

    if (walineUser) {
      try {
        var user = JSON.parse(walineUser);
        if (user && user.avatar) {
          userAvatar.src = user.avatar;
          userAvatar.classList.remove('hidden');
          defaultIcon.classList.add('hidden');
          userNameEl.textContent = user.display_name || user.nick || '已登录';
          logoutBtn.classList.remove('hidden');

          var openProfile = function() {
            window.open(baseUrl + 'ui/profile/', '_blank');
          };
          userMenu.onclick = openProfile;
          userSettingsBtn.onclick = openProfile;

          logoutBtn.onclick = function() {
            localStorage.removeItem('WALINE_USER');
            window.location.reload();
          };
          return;
        }
      } catch (e) {
        console.error('Failed to parse Waline user', e);
      }
    }
    
    userAvatar.classList.add('hidden');
    defaultIcon.classList.remove('hidden');
    userNameEl.textContent = '未登录';
    logoutBtn.classList.add('hidden');

    var openLogin = function() {
      window.open(baseUrl + 'ui/login/', '_blank');
    };
    userMenu.onclick = openLogin;
    userSettingsBtn.onclick = openLogin;
    userSettingsBtn.textContent = '登录 / 注册';
  }

  function bindHandlers() {
    var themeBtn = document.getElementById('theme-toggle');
    var mobileBtn = document.getElementById('mobile-menu-btn');

    if (themeBtn) {
      themeBtn.removeEventListener('click', handleThemeToggle);
      themeBtn.addEventListener('click', handleThemeToggle);
    }

    if (mobileBtn) {
      mobileBtn.removeEventListener('click', handleMobileMenu);
      mobileBtn.addEventListener('click', handleMobileMenu);
    }

    updateUserStatus();
  }

  bindHandlers();

  window.addEventListener('waline-user-changed', updateUserStatus);
  window.addEventListener('storage', (e) => {
    if (e.key === 'WALINE_USER') updateUserStatus();
  });

  document.addEventListener('astro:after-swap', function() {
    bindHandlers();
  });
</script>
