---
import { getCollection } from "astro:content";
import { SITE_TITLE, NAV_ITEMS, SITE_URL, SITE_AUTHOR } from "@/consts";
import { getWordCount } from "@/utils/readingTime";

const allBlogPosts = await getCollection("blog");
const totalArticles = allBlogPosts.length;

let totalWords = 0;
for (const post of allBlogPosts) {
  totalWords += getWordCount(post.body || "");
}

const currentYear = new Date().getFullYear();
const startYear = 2023;
---

<footer class="border-t border-gray-200/50 dark:border-gray-700/50 mt-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div
      class="flex flex-wrap items-center justify-center gap-6 text-sm text-gray-400 dark:text-gray-500 mb-6"
    >
      <span>{Math.round(totalWords / 1000)}k 字</span>
      <span class="w-px h-3 bg-gray-300 dark:bg-gray-600"></span>
      <span>{totalArticles} 篇</span>
    </div>

    <div
      class="flex flex-col sm:flex-row items-center justify-center gap-1 text-xs text-gray-500 dark:text-gray-400"
    >
      <span
        >Copyright&nbsp;&copy; {startYear}{
          currentYear > startYear ? ` - ${currentYear}` : ""
        } &nbsp;{SITE_AUTHOR}
      </span>
      <span class="hidden sm:inline text-gray-300 dark:text-gray-600">|</span>
      <span>
        Made with <a
          href="https://github.com/santisify/astro-theme-sify/"
          class="hover:underline">Santisify</a
        >
      </span>
      <span class="hidden sm:inline text-gray-300 dark:text-gray-600">|</span>
      <span>
        Powered by <a href="https://astro.build" class="hover:underline"
          >Astro</a
        > &amp; <a href="https://tailwindcss.com/" class="hover:underline"
          >Tailwind</a
        >
      </span>
      <span class="hidden lg:inline text-gray-300 dark:text-gray-600">|</span>
      <span>
        <a
          v-if="siteIcp"
          href="https://beian.miit.gov.cn"
          target="_blank"
          class="hover:underline"
        >
          浙ICP备2024055100号
        </a>
      </span>
      <span class="hidden sm:inline text-gray-300 dark:text-gray-600">|</span>
      <span>
        <a
          v-if="siteMps"
          href="https://beian.mps.gov.cn"
          target="_blank"
          class="hover:underline"
        >
          浙公网安备33020602000992号
        </a>
      </span>
      <span class="hidden sm:inline text-gray-300 dark:text-gray-600">|</span>
      <span>
        <a
          v-if="siteMICP"
          href="https://icp.gov.moe/?keyword=20257739"
          target="_blank"
          class="hover:underline"
        >
          萌ICP备20257739号
        </a>
      </span>
    </div>

    <div
      class="flex items-center justify-center gap-4 mt-4 text-xs text-gray-400 dark:text-gray-500"
    >
      {
        NAV_ITEMS.map((item) => (
          <a href={item.href} class="hover:text-primary transition-colors">
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>
